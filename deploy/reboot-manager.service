[Unit]
Description=Reboot Manager (Flask / Gunicorn)
After=network.target

[Service]
# Uncomment and set User/Group if you wish to run as a specific non-root user (e.g., User=jenkins or User=pi).
# If omitted, systemd runs the service as root, so its `sudo systemctl reboot` call is a no-op under root.
# User=pi
# Group=pi
WorkingDirectory=/opt/wifipi/reboot_manager
ExecStart=/opt/wifipi/.venv/bin/gunicorn --bind 0.0.0.0:5011 --workers 1 --threads 4 --timeout 120 app:app
Restart=always

[Install]
WantedBy=multi-user.target

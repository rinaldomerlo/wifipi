[Unit]
Description=WiFi Channel & Utilization Monitor (Flask / Gunicorn)
After=network.target

[Service]
User=pi
Group=pi
WorkingDirectory=/opt/wifipi/wifi_utilization_monitor
ExecStart=/opt/wifipi/.venv/bin/gunicorn --bind 127.0.0.1:8000 --workers 2 --timeout 60 app:app
Restart=always

[Install]
WantedBy=multi-user.target

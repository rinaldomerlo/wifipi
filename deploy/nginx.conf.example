# Nginx configuration example for WiFiPi applications on Raspberry Pi
# Place this configuration file in /etc/nginx/sites-available/wifipi
# and create a symbolic link in /etc/nginx/sites-enabled/:
#   sudo ln -s /etc/nginx/sites-available/wifipi /etc/nginx/sites-enabled/
#   sudo nginx -t
#   sudo systemctl restart nginx
#
# This file is app-independent. The per-app reverse-proxy blocks live in
# separate snippets under deploy/nginx.d/ and are pulled in by the
# `include /etc/nginx/wifipi.d/*.conf;` line below. Each Raspberry Pi installs
# only the snippets for the apps it actually runs, so an app that isn't
# installed simply has no location block (a clean 404) rather than a 502:
#   sudo mkdir -p /etc/nginx/wifipi.d
#   sudo cp deploy/nginx.d/wifimon.conf   /etc/nginx/wifipi.d/   # e.g. a monitor Pi
#   sudo cp deploy/nginx.d/roaming.conf   /etc/nginx/wifipi.d/
# A wildcard include that matches nothing is valid, so a Pi with no snippets
# still serves the landing page fine. See README.md for the per-role install.

server {
    listen 80 default_server;
    listen [::]:80 default_server;
    server_name _;

    # Static landing webpage (Root /)
    location / {
        root /opt/wifipi/www;
        index index.html;
        try_files $uri $uri/ =404;

        # Server Side Includes let index.html print this machine's real host name
        # via <!--# echo var="hostname" -->. Without it the landing page falls back
        # to querying an app, then to the address in the URL bar (often just an IP).
        ssi on;
    }

    # Per-app reverse-proxy blocks (deploy/nginx.d/<app>.conf), installed per Pi.
    # The landing page (www/index.html) self-discovers which apps are actually up
    # by probing each /<app>/api/hostname, so it too reflects only what's installed.
    include /etc/nginx/wifipi.d/*.conf;
}

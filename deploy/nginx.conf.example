# Nginx configuration example for WiFiPi applications on Raspberry Pi
# Place this configuration file in /etc/nginx/sites-available/wifipi
# and create a symbolic link in /etc/nginx/sites-enabled/:
#   sudo ln -s /etc/nginx/sites-available/wifipi /etc/nginx/sites-enabled/
#   sudo nginx -t
#   sudo systemctl restart nginx

server {
    listen 80 default_server;
    listen [::]:80 default_server;
    server_name _;

    # Static landing webpage (Root /)
    location / {
        root /opt/wifipi/www;
        index index.html;
        try_files $uri $uri/ =404;

        # Server Side Includes let index.html print this machine's real host name
        # via <!--# echo var="hostname" -->. Without it the landing page falls back
        # to querying an app, then to the address in the URL bar (often just an IP).
        ssi on;
    }

    # Automatic redirect to trailing-slash URLs for subpath apps
    location = /wifimon {
        return 301 /wifimon/;
    }

    location = /iperf {
        return 301 /iperf/;
    }

    location = /iperfserver {
        return 301 /iperfserver/;
    }

    location = /wificonnect {
        return 301 /wificonnect/;
    }

    location = /webbrowse {
        return 301 /webbrowse/;
    }

    location = /clientsim {
        return 301 /clientsim/;
    }

    location = /devices {
        return 301 /devices/;
    }

    # WiFi Channel & Utilization Monitor subpath (/wifimon/)
    location /wifimon/ {
        proxy_pass http://127.0.0.1:5000/;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # iPerf3 Congestion Generator subpath (/iperf/)
    location /iperf/ {
        proxy_pass http://127.0.0.1:5001/;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;

        # Disable buffering for real-time Server-Sent Events (SSE) iperf3 output streaming
        proxy_buffering off;
        proxy_cache off;
        chunked_transfer_encoding on;
    }

    # iPerf3 Server Manager subpath (/iperfserver/)
    location /iperfserver/ {
        proxy_pass http://127.0.0.1:5002/;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # WiFi Connection Manager subpath (/wificonnect/)
    location /wificonnect/ {
        proxy_pass http://127.0.0.1:5003/;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # Web Browsing Simulator's generated content (/webbrowse/content/) -- served directly by nginx
    # as static files (bypassing Python) since this is just bulk random bytes. Must come before the
    # generic /webbrowse/ proxy block below; nginx picks the longest matching prefix, so declaration
    # order doesn't actually matter, but keeping the more specific block first reads more clearly.
    location /webbrowse/content/ {
        alias /opt/wifipi/web_browsing_simulator/content/;
    }

    # Web Browsing Simulator subpath (/webbrowse/)
    location /webbrowse/ {
        proxy_pass http://127.0.0.1:5004/;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;

        # Disable buffering for real-time Server-Sent Events (SSE) page-load output streaming
        proxy_buffering off;
        proxy_cache off;
        chunked_transfer_encoding on;
    }

    # Client Simulator subpath (/clientsim/)
    location /clientsim/ {
        proxy_pass http://127.0.0.1:5005/;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;

        # Disable buffering for real-time Server-Sent Events (SSE) client-activity streaming
        proxy_buffering off;
        proxy_cache off;
        chunked_transfer_encoding on;
    }

    # Network Device Scanner subpath (/devices/)
    location /devices/ {
        proxy_pass http://127.0.0.1:5006/;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
}

#!/bin/sh
# WiFiPi: stamp the current git version into the version-badge pages on every
# commit, so the static pages served from the Pi always report the deployed
# version without the Pi (or nginx) ever running git.
#
# Enable once per clone with:
#     git config core.hooksPath .githooks
set -e

ROOT="$(git rev-parse --show-toplevel)"

# No --dirty here: the commit being created will be clean, so a "-dirty" suffix
# (true only because the changes are still staged) would be misleading. The
# parent commit's tag/height is what this commit's version should read.
VERSION="$(git describe --tags --always 2>/dev/null || echo unknown)"

"$ROOT/.githooks/stamp-version.sh" "$VERSION"

# Fold each refreshed page into this commit only if its version actually
# changed, so ordinary commits that don't move the version don't drag either
# page in.
for PAGE in www/index.html wifi_utilization_monitor/templates/index.html; do
    if ! git diff --quiet -- "$PAGE"; then
        git add "$PAGE"
    fi
done
